flowchart TB
    subgraph K8s["Kubernetes"]
        Gateway["API Gateway / Ingress"]
        subgraph Workloads["Containerized Services"]
            BK["Booking"]
            CA["Corporate Account"]
            FL["Fleet"]
            SO["Station Operations"]
            BI["Billing"]
            PY["Payment"]
            NT["Notification"]
        end
        OTel["OpenTelemetry Collector"]
    end

    BKDB[("Booking DB")]
    CADB[("Corporate Account DB")]
    FLDB[("Fleet DB")]
    SODB[("Station Operations DB")]
    BIDB[("Billing DB")]
    PYDB[("Payment DB")]
    NTDB[("Notification DB")]
    Redis[("Approved read cache")]
    Bus["Event Platform"]
    Secrets["Workload Identity / Secrets Platform"]
    Monitoring["Monitoring Platform"]

    Gateway --> BK
    Gateway --> CA
    Gateway --> FL
    Gateway --> SO
    Gateway --> BI
    Gateway --> PY

    BK --> BKDB
    CA --> CADB
