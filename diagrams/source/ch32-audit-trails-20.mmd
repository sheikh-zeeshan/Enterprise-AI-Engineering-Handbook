    EVAL --> HUMAN["Human approval"]
    HUMAN --> RESULT["Final outcome"]
    RUN -.-> AUDIT["Structured audit events"]
    EXEC -.-> AUDIT
    CHANGE -.-> AUDIT
    REVIEW -.-> AUDIT
    EVAL -.-> AUDIT
    HUMAN -.-> AUDIT
    RESULT -.-> AUDIT
    AUDIT --> STORE[("Governed audit store")]
